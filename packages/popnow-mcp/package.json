{
  "name": "@popnow/mcp",
  "version": "0.3.0",
  "description": "Local stdio bridge to the PopNow developer MCP server: call any AI image, video and audio model with a PopNow API key, billed in USD.",
  "mcpName": "io.github.popnow-ai/popnow-api-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "popnow-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "popnow",
    "ai-video-generator",
    "ai-image-generator",
    "text-to-video",
    "image-to-video",
    "ai-music-generator",
    "cursor",
    "api-key",
    "claude-code",
    "codex"
  ],
  "homepage": "https://popnow.ai/api/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popnow-ai/popnow-api-mcp.git",
    "directory": "packages/popnow-mcp"
  },
  "bugs": {
    "url": "https://github.com/popnow-ai/popnow-api-mcp/issues"
  }
}
